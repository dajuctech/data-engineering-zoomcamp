    "# Navigate to pipeline directory\n",
    "cd /workspaces/data-engineering-zoomcamp/pipeline\n",
    "\n",
    "# Download Yellow taxi data (January 2021)\n",
    "curl -o yellow_tripdata_2021-01.csv.gz \\\n",
    "  https://github.com/DataTalksClub/nyc-tlc-data/releases/download/yellow/yellow_tripdata_2021-01.csv.gz\n",
    "\n",
    "# Download Green taxi data (January 2021)\n",
    "curl -o green_tripdata_2021-01.csv.gz \\\n",
    "  https://github.com/DataTalksClub/nyc-tlc-data/releases/download/green/green_tripdata_2021-01.csv.gz\n",
    "\n",
    "# Download Taxi zones lookup table\n",
    "curl -o taxi_zone_lookup.csv \\\n",
    "  https://d37ci6vzurychx.cloudfront.net/misc/taxi_zone_lookup.csv\n",
    "\n",
    "# Login to Google Cloud\n",
    "gcloud auth login\n",
    "\n",
    "# Set your project (replace YOUR_PROJECT_ID with your actual project ID)\n",
    "gcloud config set project YOUR_PROJECT_ID\n",
    "\n",
    "# Create a GCS bucket (replace <your-name> with something unique like your-initials-taxi)\n",
    "gsutil mb -l us-central1 gs://nyc-taxi-data-<your-name>/\n",
    "\n",
    "# Upload Yellow taxi data\n",
    "gsutil cp yellow_tripdata_2021-01.csv.gz gs://nyc-taxi-data-<your-name>/yellow/\n",
    "\n",
    "# Upload Green taxi data\n",
    "gsutil cp green_tripdata_2021-01.csv.gz gs://nyc-taxi-data-<your-name>/green/\n",
    "\n",
    "# Upload zones lookup\n",
    "gsutil cp taxi_zone_lookup.csv gs://nyc-taxi-data-<your-name>/zones/\n",
    "\n",
    "# Verify uploads\n",
    "gsutil ls gs://nyc-taxi-data-<your-name>/"
   ]
