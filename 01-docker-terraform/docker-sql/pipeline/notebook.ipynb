    "# Create iterator for chunked reading\n",
    "df_iter = pd.read_csv(url, dtype=dtype, parse_dates=parse_dates, \n",
    "                       iterator=True, chunksize=100000)\n",
    "\n",
    "# Get first chunk\n",
    "first_chunk = next(df_iter)\n",
    "\n",
    "# Create table (schema only)\n",
    "first_chunk.head(0).to_sql(name='yellow_taxi_data', con=engine, if_exists='replace')\n",
    "print(\"Table created\")\n",
    "\n",
    "# Insert first chunk\n",
    "first_chunk.to_sql(name='yellow_taxi_data', con=engine, if_exists='append')\n",
    "print(f\"Inserted first chunk: {len(first_chunk)}\")\n",
    "\n",
    "# Insert remaining chunks\n",
    "for df_chunk in tqdm(df_iter):\n",
    "    df_chunk.to_sql(name='yellow_taxi_data', con=engine, if_exists='append')\n",
    "    print(f\"Inserted chunk: {len(df_chunk)}\")\n",
    "\n",
    "print(\"Data ingestion complete!\")"
